@page
@model CasaVintage.Pages.BienvenidaModel
@{
    ViewData["Title"] = "Welcome";
    Layout = "_Layout";
    var nombre = User.Identity?.Name ?? "";
    var primerNombre = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? nombre;
}

<div class="bienvenida-inicio">
    <span class="kicker">The Vintage House</span>
    <h1 class="mb-2">Hello, @primerNombre</h1>
    <p class="text-muted bienvenida-inicio-texto">
        Your workspace is being built. As soon as your section is ready, you will go straight to it
        when you sign in. In the meantime, use the side menu to navigate.
    </p>

    <p class="text-muted" style="font-size:0.9rem;">You will find your sections in the menu on the left.</p>
</div>
