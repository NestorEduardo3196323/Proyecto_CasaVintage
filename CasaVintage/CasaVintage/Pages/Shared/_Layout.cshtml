@inject CasaVintage.Services.ICarritoService Carrito
@inject CasaVintage.Services.IMarcaService Marca
@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var nombre = User.Identity?.Name ?? "";
    var rol = User.FindFirst(ClaimTypes.Role)?.Value;
    var secciones = MenuRol.Para(rol);
    var paginaActual = ViewContext.RouteData.Values["page"] as string;
    var foto = PerfilUsuario.Foto(User);
    var carritoCount = autenticado ? Carrito.Contar() : 0;
    var logoMarca = autenticado ? Marca.RutaLogo() : null;

    // SVG icons (feather) by key; the layout draws the <svg> and this returns its inner content.
    string Icono(string clave) => clave switch
    {
        "users" => "<path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/>",
        "box" => "<path d=\"M12.89 1.45l8 4A2 2 0 0 1 22 7.24v9.53a2 2 0 0 1-1.11 1.79l-8 4a2 2 0 0 1-1.79 0l-8-4a2 2 0 0 1-1.1-1.8V7.24a2 2 0 0 1 1.11-1.79l8-4a2 2 0 0 1 1.78 0z\"/><polyline points=\"2.32 6.16 12 11 21.68 6.16\"/><line x1=\"12\" y1=\"22.76\" x2=\"12\" y2=\"11\"/>",
        "truck" => "<rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"/><polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"/><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"/><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"/>",
        "cart" => "<circle cx=\"9\" cy=\"21\" r=\"1\"/><circle cx=\"20\" cy=\"21\" r=\"1\"/><path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\"/>",
        "chart" => "<line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"/><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"/><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"/>",
        "receipt" => "<path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/>",
        "history" => "<circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/>",
        "image" => "<rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><polyline points=\"21 15 16 10 5 21\"/>",
        _ => "<rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/>"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - La Casa Vintage</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Jost:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CasaVintage.styles.css" asp-append-version="true" />
</head>
<body>
    @if (autenticado)
    {
        @Html.AntiForgeryToken()
        <div class="app-shell" id="appShell">
            <div class="sidebar-backdrop" data-cerrar-menu></div>

            <aside class="sidebar">
                <a class="sidebar-marca" asp-page="/Index">
                    @if (logoMarca is not null)
                    {
                        <img src="@logoMarca" alt="La Casa Vintage" class="marca-logo-img" />
                    }
                    else
                    {
                        <span class="marca-logo">V</span>
                    }
                    <span class="marca-nombre">La Casa Vintage</span>
                </a>

                <nav class="sidebar-nav">
                    @foreach (var seccion in secciones)
                    {
                        <p class="sidebar-seccion">@seccion.Titulo</p>
                        @foreach (var item in seccion.Items)
                        {
                            if (item.Disponible && item.Pagina is not null)
                            {
                                var activo = string.Equals(item.Pagina, paginaActual, StringComparison.OrdinalIgnoreCase) ? "activo" : "";
                                <a class="nav-item @activo" asp-page="@item.Pagina">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(Icono(item.Icono))</svg>
                                    <span>@item.Texto</span>
                                    @if (item.Pagina == "/Carrito/Index")
                                    {
                                        <span class="nav-badge" id="carritoBadge" hidden="@(carritoCount > 0 ? null : "hidden")">@carritoCount</span>
                                    }
                                </a>
                            }
                            else
                            {
                                <span class="nav-item deshabilitado">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(Icono(item.Icono))</svg>
                                    <span>@item.Texto</span>
                                    <span class="badge-pronto">soon</span>
                                </span>
                            }
                        }
                    }
                </nav>

                <div class="sidebar-pie">
                    <div class="sidebar-tarjeta">
                        @if (logoMarca is not null)
                        {
                            <img src="@logoMarca" alt="La Casa Vintage" class="marca-logo-img marca-logo-pie" />
                        }
                        else
                        {
                            <span class="marca-logo" style="width:30px;height:30px;">V</span>
                        }
                        <div>
                            <div class="titulo">La Casa Vintage</div>
                            <div class="sub">Internal panel</div>
                        </div>
                    </div>
                </div>
            </aside>

            <div class="app-main">
                <header class="topbar">
                    <button class="btn-menu-movil" type="button" data-abrir-menu aria-label="Open menu">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
                    </button>

                    <div class="topbar-derecha">
                        <div class="topbar-usuario">
                            <div class="datos">
                                <div class="nombre">@nombre</div>
                                <div class="rol">@RolInfo.Etiqueta(rol)</div>
                            </div>
                            @if (foto is not null)
                            {
                                <img src="@foto" alt="Photo of @nombre" class="avatar-foto" />
                            }
                            else
                            {
                                <span class="avatar-iniciales">@PerfilUsuario.Iniciales(nombre)</span>
                            }
                        </div>
                        <form method="post" asp-page="/Cuenta/Logout" class="m-0">
                            <button type="submit" class="btn-vintage-outline btn-sm">Sign out</button>
                        </form>
                    </div>
                </header>

                <main role="main" class="content">
                    @RenderBody()
                </main>
            </div>
        </div>

        <partial name="_TarjetaBienvenida" />
    }
    else
    {
        <div class="auth-wrap">
            <div class="auth-inner">
                @RenderBody()
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
