@{
    // Shown only once, when landing on the panel after login (flag set at login).
    var mostrar = TempData["MostrarBienvenida"] as string == "1";
    if (!mostrar)
    {
        return;
    }

    var nombre = User.Identity?.Name ?? "";
    var primerNombre = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? nombre;
    var rol = User.FindFirst(ClaimTypes.Role)?.Value;
    var fecha = PerfilUsuario.FechaIngreso(User);
    var foto = PerfilUsuario.Foto(User);
}

<div class="bienvenida-overlay" id="bienvenidaOverlay">
    <div class="bienvenida-tarjeta">
        <form method="post" asp-page="/Cuenta/Logout" class="m-0">
            <button type="submit" class="bienvenida-cerrar" title="Do not enter and sign out" aria-label="Do not enter and sign out">&times;</button>
        </form>

        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
            <div>
                <span class="kicker">Welcome</span>
                <h2 class="h4 mb-0">Hello, @primerNombre</h2>
            </div>
            @if (foto is not null)
            {
                <img src="@foto" alt="Photo of @nombre" class="avatar-foto grande" />
            }
            else
            {
                <span class="avatar-iniciales grande">@PerfilUsuario.Iniciales(nombre)</span>
            }
        </div>

        <p class="bienvenida-dato mb-1"><strong>Role:</strong> @RolInfo.Etiqueta(rol)</p>
        <p class="bienvenida-dato mb-4">
            <strong>Join date:</strong>
            @(fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy") : "Not available")
        </p>

        <button type="button" class="btn-vintage w-100" id="btnIngresarBienvenida">Enter</button>
    </div>
</div>
