@page
@model CasaVintage.Pages.Cuenta.LoginModel
@inject CasaVintage.Services.IMarcaService Marca
@{
    ViewData["Title"] = "Sign in";
    Layout = "_Layout";
    var logoLogin = Marca.RutaLogo();
}

<video class="login-video-fondo" autoplay muted loop playsinline preload="auto">
    <source src="@Url.Content("~/media/Video.mp4")" type="video/mp4" />
</video>
<div class="login-video-overlay"></div>

<div class="tarjeta-vintage tarjeta-login">
    <div class="p-4 p-md-5">
        <div class="text-center mb-4">
            @if (logoLogin is not null)
            {
                <img src="@logoLogin" alt="The Vintage House" class="marca-logo-img marca-logo-login" />
            }
            else
            {
                <span class="marca-logo mx-auto d-inline-flex" style="width:64px;height:64px;font-size:2rem;">V</span>
            }
            <h1 class="h3 mt-3 mb-1">The Vintage House</h1>
            <p class="text-muted mb-0">Internal inventory and sales system</p>
        </div>

        <form method="post">
            <div asp-validation-summary="All" class="alerta-vintage alerta-error mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Entrada.Correo" class="form-label"></label>
                <input asp-for="Entrada.Correo" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Entrada.Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Entrada.Password" class="form-label"></label>
                <input asp-for="Entrada.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Entrada.Password" class="text-danger"></span>
            </div>

            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <button type="submit" class="btn-vintage w-100 mt-2">Sign in</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // On reaching the login (for example after signing out) the catalog preference is
        // cleared so every user starts with out-of-stock items visible and does not inherit
        // the previous session's "eye toggle" state.
        try { localStorage.removeItem("catalogoOcultarAgotados"); } catch (e) { }
    </script>
}
