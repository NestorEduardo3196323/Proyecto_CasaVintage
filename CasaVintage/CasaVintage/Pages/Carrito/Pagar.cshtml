@page
@model CasaVintage.Pages.Carrito.PagarModel
@{
    ViewData["Title"] = "Checkout";
    Layout = "_Layout";
    var carrito = Model.Carrito;
}

<a asp-page="Index" class="volver-link">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></svg>
    Back to cart
</a>

<div class="mb-4">
    <span class="kicker">Sales</span>
    <h1 class="mb-1">Checkout</h1>
    <p class="text-muted mb-0">Capture the customer data and the payment method to register the sale.</p>
</div>

<form method="post" id="form-cobro">
    <div asp-validation-summary="ModelOnly" class="alerta-vintage alerta-error mb-4" role="alert"></div>

    <div class="carrito-grid">
        <div class="tarjeta-vintage p-4">
            <h2 class="h6 mb-3">Customer data</h2>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Entrada.ClienteNombre" class="form-label"></label>
                    <input asp-for="Entrada.ClienteNombre" class="form-control" autocomplete="name" autofocus />
                    <span asp-validation-for="Entrada.ClienteNombre" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Entrada.ClienteCorreo" class="form-label"></label>
                    <input asp-for="Entrada.ClienteCorreo" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Entrada.ClienteCorreo" class="text-danger"></span>
                </div>
            </div>

            <h2 class="h6 mt-4 mb-3">Payment method</h2>
            <div class="pago-opciones">
                <label class="pago-opcion">
                    <input type="radio" asp-for="Entrada.MetodoPago" value="Efectivo" />
                    <span class="pago-cara">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2" /><circle cx="12" cy="12" r="2.5" /></svg>
                        Cash
                    </span>
                </label>
                <label class="pago-opcion">
                    <input type="radio" asp-for="Entrada.MetodoPago" value="Tarjeta" />
                    <span class="pago-cara">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
                        Card
                    </span>
                </label>
            </div>
            <span asp-validation-for="Entrada.MetodoPago" class="text-danger d-block mt-1"></span>

            <div id="tarjeta-datos" class="tarjeta-datos-pago" @(Model.Entrada.EsTarjeta ? null : "hidden")>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Entrada.NumeroTarjeta" class="form-label"></label>
                        <input asp-for="Entrada.NumeroTarjeta" class="form-control" inputmode="numeric" autocomplete="cc-number" maxlength="19" placeholder="0000 0000 0000 0000" data-tarjeta-numero />
                        <span asp-validation-for="Entrada.NumeroTarjeta" class="text-danger"></span>
                        <span class="text-danger" id="err-t-numero"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Entrada.TitularTarjeta" class="form-label"></label>
                        <input asp-for="Entrada.TitularTarjeta" class="form-control" autocomplete="cc-name" />
                        <span asp-validation-for="Entrada.TitularTarjeta" class="text-danger"></span>
                        <span class="text-danger" id="err-t-titular"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Entrada.VencimientoTarjeta" class="form-label"></label>
                        <input asp-for="Entrada.VencimientoTarjeta" class="form-control" inputmode="numeric" autocomplete="cc-exp" maxlength="5" placeholder="MM/YY" data-tarjeta-venc />
                        <span asp-validation-for="Entrada.VencimientoTarjeta" class="text-danger"></span>
                        <span class="text-danger" id="err-t-venc"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Entrada.CvvTarjeta" class="form-label"></label>
                        <input asp-for="Entrada.CvvTarjeta" class="form-control" inputmode="numeric" autocomplete="cc-csc" maxlength="4" placeholder="123" data-tarjeta-cvv />
                        <span asp-validation-for="Entrada.CvvTarjeta" class="text-danger"></span>
                        <span class="text-danger" id="err-t-cvv"></span>
                    </div>
                </div>
            </div>
        </div>

        <aside class="carrito-resumen tarjeta-vintage">
            <h2 class="h6 mb-3">Sale summary</h2>
            <ul class="resumen-items">
                @foreach (var item in carrito.Items)
                {
                    <li>
                        <span>@item.Cantidad &times; @item.Nombre</span>
                        <span>$@item.Subtotal.ToString("N2")</span>
                    </li>
                }
            </ul>
            <div class="resumen-linea total">
                <span>Total</span>
                <span class="producto-precio">$@carrito.TotalPrecio.ToString("N2")</span>
            </div>
            <button type="submit" class="btn-vintage w-100 mt-3">Confirm sale</button>
        </aside>
    </div>
</form>

<div id="pago-overlay" class="pago-overlay" hidden>
    <div class="pago-overlay-caja">
        <div class="pago-spinner" aria-hidden="true"></div>
        <p id="pago-overlay-texto">Processing payment...</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Card payment (simulated): shows/hides the form by method, formats the fields, validates on
        // the client and simulates the approval (Processing -> Approved) before submitting.
        (function () {
            var form = document.getElementById("form-cobro");
            if (!form) { return; }
            var cont = document.getElementById("tarjeta-datos");
            var num = form.querySelector("[data-tarjeta-numero]");
            var venc = form.querySelector("[data-tarjeta-venc]");
            var cvv = form.querySelector("[data-tarjeta-cvv]");
            var titular = document.getElementById("Entrada_TitularTarjeta");
            var overlay = document.getElementById("pago-overlay");
            var overlayTexto = document.getElementById("pago-overlay-texto");

            function esTarjeta() {
                var r = form.querySelector('input[name="Entrada.MetodoPago"]:checked');
                return !!r && r.value === "Tarjeta";
            }
            function alternar() { if (cont) { cont.hidden = !esTarjeta(); } }
            form.querySelectorAll('input[name="Entrada.MetodoPago"]').forEach(function (r) {
                r.addEventListener("change", alternar);
            });

            // Field formatting while typing.
            if (num) num.addEventListener("input", function () {
                var d = num.value.replace(/\D/g, "").slice(0, 16);
                num.value = d.replace(/(.{4})/g, "$1 ").trim();
            });
            if (venc) venc.addEventListener("input", function () {
                var d = venc.value.replace(/\D/g, "").slice(0, 4);
                venc.value = d.length > 2 ? d.slice(0, 2) + "/" + d.slice(2) : d;
            });
            if (cvv) cvv.addEventListener("input", function () {
                cvv.value = cvv.value.replace(/\D/g, "").slice(0, 4);
            });

            // Writes the message in the field's own span (not the asp-validation-for one, which
            // jQuery resets when re-validating the form).
            function ponerError(clave, msg) {
                var span = document.getElementById("err-t-" + clave);
                if (span) { span.textContent = msg || ""; }
            }
            function luhn(n) {
                var s = 0, alterna = false;
                for (var i = n.length - 1; i >= 0; i--) {
                    var d = +n[i];
                    if (alterna) { d *= 2; if (d > 9) { d -= 9; } }
                    s += d; alterna = !alterna;
                }
                return s % 10 === 0;
            }
            function vencOk(v) {
                var m = /^(\d{2})\/(\d{2})$/.exec((v || "").trim());
                if (!m) { return false; }
                var mes = +m[1], anio = 2000 + (+m[2]);
                if (mes < 1 || mes > 12) { return false; }
                var hoy = new Date();
                var ultimo = new Date(anio, mes, 0);
                return ultimo >= new Date(hoy.getFullYear(), hoy.getMonth(), 1);
            }
            function validarTarjeta() {
                var ok = true;
                var n = (num.value || "").replace(/\D/g, "");
                if (n.length !== 16) { ponerError("numero", "The card number must have 16 digits."); ok = false; }
                else if (!luhn(n)) { ponerError("numero", "The card number is not valid."); ok = false; }
                else { ponerError("numero", ""); }
                if (!titular.value.trim()) { ponerError("titular", "The cardholder is required."); ok = false; }
                else { ponerError("titular", ""); }
                if (!vencOk(venc.value)) { ponerError("venc", "The expiry must be in MM/YY format and not be expired."); ok = false; }
                else { ponerError("venc", ""); }
                var c = (cvv.value || "").replace(/\D/g, "");
                if (c.length !== 3 && c.length !== 4) { ponerError("cvv", "The CVV must have 3 or 4 digits."); ok = false; }
                else { ponerError("cvv", ""); }
                return ok;
            }

            form.addEventListener("submit", function (e) {
                if (!esTarjeta()) { return; } // Cash: normal flow.
                e.preventDefault();
                // The rest is validated first (jQuery) and then the card, so jQuery does not clear
                // the card messages when re-validating the form.
                var restoOk = !(window.jQuery && window.jQuery.fn.valid) || window.jQuery(form).valid();
                var tarjetaOk = validarTarjeta();
                if (!tarjetaOk || !restoOk) { return; }
                // Approval simulation before submitting the sale.
                overlay.hidden = false;
                overlayTexto.textContent = "Processing payment...";
                setTimeout(function () {
                    overlayTexto.textContent = "Payment approved";
                    setTimeout(function () { form.submit(); }, 700);
                }, 1300);
            });

            alternar();
        })();
    </script>
}
