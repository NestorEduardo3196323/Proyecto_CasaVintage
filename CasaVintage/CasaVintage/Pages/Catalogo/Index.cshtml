@page
@model CasaVintage.Pages.Catalogo.IndexModel
@{
    ViewData["Title"] = "Catalogo";
    Layout = "_Layout";
}

@if (Model.Productos.Count == 0)
{
    <div class="mb-4">
        <span class="kicker">Catalogo</span>
        <h1 class="mb-1">Catalogo de productos</h1>
    </div>
    <div class="tarjeta-vintage estado-vacio">
        <h2 class="h5 mb-2">El catalogo esta vacio</h2>
        <p class="text-muted mb-0">Cuando el inventario tenga productos, apareceran aqui.</p>
    </div>
}
else
{
    <section class="catalogo-hero">
        <div class="hero-texto">
            <span class="kicker">Catalogo</span>
            <h1>Piezas con historia, listas para su nuevo hogar</h1>
            <p class="text-muted mb-0">Explora las antigüedades disponibles y encuentra la pieza perfecta para cada cliente.</p>
        </div>

        @if (Model.Destacados.Count > 0)
        {
            <div class="hero-showcase" data-hero>
                @for (var i = 0; i < Model.Destacados.Count; i++)
                {
                    var d = Model.Destacados[i];
                    <article class="hero-slide @(i == 0 ? "activa" : "")" data-hero-slide>
                        <div class="hero-slide-img">
                            @if (!string.IsNullOrEmpty(d.Foto1))
                            {
                                <img src="@d.Foto1" alt="@d.Nombre" />
                            }
                            else
                            {
                                <span class="producto-sin-foto" aria-hidden="true">
                                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                                </span>
                            }
                        </div>
                        <div class="hero-slide-info">
                            <span class="producto-categoria">@d.Categoria</span>
                            <h3>@d.Nombre</h3>
                            <p class="hero-slide-precio">$@d.Precio.ToString("N2") &middot; @d.Epoca</p>
                        </div>
                    </article>
                }
                <div class="hero-dots" data-hero-dots></div>
            </div>
        }
    </section>

    <div class="catalogo-toolbar">
        <div class="buscador-tabla catalogo-buscador">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            <input type="search" class="form-control" placeholder="Buscar por nombre, SKU, categoria..." data-catalogo-buscar aria-label="Buscar en el catalogo" />
        </div>
        <div class="filtro-selects">
            <select class="form-select form-select-sm" data-filtro-epoca aria-label="Filtrar por epoca">
                <option value="">Todas las epocas</option>
                @foreach (var epoca in Model.Epocas)
                {
                    <option value="@epoca">@epoca</option>
                }
            </select>
            <select class="form-select form-select-sm" data-filtro-estado aria-label="Filtrar por estado">
                <option value="">Todos los estados</option>
                @foreach (var estado in Model.Estados)
                {
                    <option value="@estado">@estado</option>
                }
            </select>
        </div>
        <button type="button" class="btn-ojito" data-toggle-agotados aria-pressed="false" title="Ocultar los productos sin stock">
            <svg data-ojo-ver width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
            <svg data-ojo-oculto width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
            <span data-texto-agotados>Ocultar agotados</span>
        </button>
    </div>

    <div class="filtro-pills" data-filtro-categoria>
        <button type="button" class="pill activo" data-cat="">Todos</button>
        @foreach (var categoria in Model.Categorias)
        {
            <button type="button" class="pill" data-cat="@categoria">@categoria</button>
        }
    </div>

    <div class="catalogo-grid" data-catalogo data-puede-agregar="@(User.IsInRole("Vendedor").ToString().ToLowerInvariant())">
        @foreach (var producto in Model.Productos)
        {
            var descripcion = producto.Descripcion.Length > 90
                ? producto.Descripcion.Substring(0, 90).TrimEnd() + "…"
                : producto.Descripcion;
            var fotos = new[] { producto.Foto1, producto.Foto2, producto.Foto3 }.Where(f => !string.IsNullOrEmpty(f)).ToList();
            <article class="producto-card @(producto.Disponibilidad ? "" : "agotado")"
                     data-categoria="@producto.Categoria" data-epoca="@producto.Epoca" data-estado="@producto.Estado">
                <div class="producto-imagen" data-fotos>
                    @if (fotos.Count > 0)
                    {
                        for (var i = 0; i < fotos.Count; i++)
                        {
                            <img src="@fotos[i]" alt="@producto.Nombre" class="producto-img @(i == 0 ? "activa" : "")" loading="lazy" />
                        }
                    }
                    else
                    {
                        <span class="producto-sin-foto" aria-hidden="true">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                        </span>
                    }
                    <span class="producto-categoria">@producto.Categoria</span>
                    @if (fotos.Count > 1)
                    {
                        <span class="producto-conteo-fotos">@fotos.Count fotos</span>
                    }
                </div>

                <div class="producto-cuerpo">
                    <div class="producto-meta">@producto.Epoca &middot; @producto.Estado</div>
                    <h3 class="producto-nombre">@producto.Nombre</h3>
                    <p class="producto-desc">@descripcion</p>

                    <div class="producto-datos">
                        <span class="sku-chip">@producto.Sku</span>
                        @if (producto.Disponibilidad)
                        {
                            <span class="badge-estado es-activo">@producto.Stock en stock</span>
                        }
                        else
                        {
                            <span class="badge-estado es-inactivo">Sin stock</span>
                        }
                    </div>

                    <div class="producto-pie">
                        <span class="producto-precio">$@producto.Precio.ToString("N2")</span>
                        <div class="producto-acciones">
                            <a asp-page="Detalle" asp-route-id="@producto.IdProducto" class="btn-vintage-outline btn-sm">Detalles</a>
                            @if (User.IsInRole("Vendedor"))
                            {
                                if (producto.Disponibilidad)
                                {
                                    <button type="button" class="btn-vintage btn-sm" data-agregar="@producto.IdProducto">Agregar</button>
                                }
                                else
                                {
                                    <button type="button" class="btn-vintage btn-sm" disabled>Agotado</button>
                                }
                            }
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>

    <p class="sin-resultados" data-catalogo-vacio hidden>No se encontraron productos con esos filtros.</p>
    <p class="text-muted mt-2" style="font-size:0.85rem;">Pasa el mouse sobre una tarjeta para ver sus fotos.</p>
}

@section Scripts {
    <script src="~/js/catalogo.js" asp-append-version="true"></script>
}
