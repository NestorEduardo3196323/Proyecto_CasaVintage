@page
@model CasaVintage.Pages.Personal.IndexModel
@{
    ViewData["Title"] = "Company staff";
    Layout = "_Layout";
    var mensaje = TempData["MensajePersonal"] as string;
    var mensajeError = TempData["MensajePersonalError"] as string;
    // When the dialog is reopened after a validation error, the employee's name is recovered.
    var nombreRestablecer = Model.ReabrirRestablecer
        ? Model.Personal.FirstOrDefault(p => p.IdUsuario == Model.Restablecer.IdUsuario)?.NombreUsuario
        : null;
}

<div class="personal-cabecera">
    <div>
        <span class="kicker">Management</span>
        <h1 class="mb-1">Company staff</h1>
        <p class="text-muted mb-0">The La Casa Vintage team. Manage the accounts, the roles and the access.</p>
    </div>
    <a asp-page="Crear" class="btn-vintage">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
        New account
    </a>
</div>

@if (mensaje is not null)
{
    <div class="alerta-vintage alerta-ok" role="status">@mensaje</div>
}
@if (mensajeError is not null)
{
    <div class="alerta-vintage alerta-error" role="alert">@mensajeError</div>
}

<div class="personal-lista" data-reveal>
    @foreach (var persona in Model.Personal)
    {
        <article class="personal-fila tarjeta-vintage @(persona.Activo ? "" : "inactiva")">
            <div class="personal-retrato">
                @if (!string.IsNullOrEmpty(persona.Foto))
                {
                    <img src="@persona.Foto" alt="Photo of @persona.NombreUsuario" class="personal-foto" loading="lazy" />
                }
                else
                {
                    <span class="avatar-iniciales showcase">@PerfilUsuario.Iniciales(persona.NombreUsuario)</span>
                }
            </div>

            <div class="personal-cuerpo">
                <span class="kicker">@RolInfo.Etiqueta(persona.Rol)</span>
                <div class="personal-titulo">
                    <h2 class="mb-0">@persona.NombreUsuario</h2>
                    <span class="badge-estado @(persona.Activo ? "es-activo" : "es-inactivo")">
                        @(persona.Activo ? "Active" : "Inactive")
                    </span>
                    @if (persona.EsUsuarioActual)
                    {
                        <span class="badge-tu">Your account</span>
                    }
                </div>

                <p class="personal-desc">@persona.Descripcion</p>

                <button type="button" class="btn-info" aria-expanded="false" aria-controls="detalle-@persona.IdUsuario" data-info-toggle>
                    <span class="btn-info-texto">Info</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                </button>

                <div class="personal-detalle" id="detalle-@persona.IdUsuario" hidden>
                    <dl class="detalle-datos">
                        <div>
                            <dt>Email</dt>
                            <dd>@persona.Correo</dd>
                        </div>
                        <div>
                            <dt>Join date</dt>
                            <dd>@persona.FechaCreado.ToString("dd/MM/yyyy")</dd>
                        </div>
                        <div>
                            <dt>Password</dt>
                            <dd class="dato-oculto">Protected (hashed)</dd>
                        </div>
                    </dl>

                    <div class="detalle-acciones">
                        <a asp-page="Editar" asp-route-id="@persona.IdUsuario" class="btn-vintage-outline btn-sm">Edit</a>

                        <button type="button" class="btn-vintage-outline btn-sm" data-restablecer
                                data-id="@persona.IdUsuario" data-nombre="@persona.NombreUsuario">
                            Reset password
                        </button>

                        @if (!persona.EsUsuarioActual)
                        {
                            <form method="post" asp-page-handler="CambiarEstado" class="m-0">
                                <input type="hidden" name="id" value="@persona.IdUsuario" />
                                <input type="hidden" name="activar" value="@((!persona.Activo).ToString().ToLower())" />
                                @if (persona.Activo)
                                {
                                    <button type="submit" class="btn-desactivar btn-sm" data-confirmar="Disable @persona.NombreUsuario's account? They will not be able to sign in until it is re-enabled.">Disable</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn-activar btn-sm">Enable</button>
                                }
                            </form>
                        }
                    </div>
                </div>
            </div>
        </article>
    }
</div>

<dialog id="dlgRestablecer" class="dialogo-vintage">
    <form method="post" asp-page-handler="Restablecer">
        <div class="dialogo-encabezado">
            <div>
                <span class="kicker">Reset password</span>
                <h2 class="h4 mb-0" id="dlgRestablecerNombre">@(nombreRestablecer ?? "Employee")</h2>
            </div>
            <button type="button" class="dialogo-cerrar" data-cerrar-dialogo aria-label="Close">&times;</button>
        </div>

        <p class="text-muted dialogo-texto">Type the new password. The previous one cannot be recovered. Share it with the employee through a secure channel.</p>

        <div asp-validation-summary="ModelOnly" class="alerta-vintage alerta-error mb-3" role="alert"></div>
        <input type="hidden" asp-for="Restablecer.IdUsuario" />

        <div class="mb-3">
            <label asp-for="Restablecer.Password" class="form-label"></label>
            <input asp-for="Restablecer.Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Restablecer.Password" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Restablecer.ConfirmarPassword" class="form-label"></label>
            <input asp-for="Restablecer.ConfirmarPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Restablecer.ConfirmarPassword" class="text-danger"></span>
        </div>

        <p class="ayuda-campo mb-4">At least 8 characters, with a letter and a number.</p>

        <div class="d-flex flex-wrap gap-2 justify-content-end">
            <button type="button" class="btn-vintage-outline" data-cerrar-dialogo>Cancel</button>
            <button type="submit" class="btn-vintage">Reset</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.CasaVintagePersonal = { reabrirRestablecer: @(Model.ReabrirRestablecer ? "true" : "false") };
    </script>
    <script src="~/js/personal.js" asp-append-version="true"></script>
}
